#!/bin/sh
# Finds the real Kimi binary and runs it unchanged.
set -euo pipefail

WRAPPER_DIR="${AIE_WRAPPER_BIN:-$(CDPATH= cd -- "$(dirname "$0")" && pwd)}"
REAL=""
OLD_IFS=$IFS
IFS=:
for dir in $PATH; do
  [ "$dir" = "$WRAPPER_DIR" ] && continue
  if [ -n "$dir" ] && [ -x "$dir/kimi" ]; then
    REAL="$dir/kimi"
    break
  fi
done
IFS=$OLD_IFS

if [ -z "$REAL" ]; then
  echo "aie-kimi-wrapper: kimi not found on PATH" >&2
  exit 127
fi

exec "$REAL" "$@"
